# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
APP_NAME=Oral Narrative Preservation System
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ─────────────────────────────────────────────
# CORS (comma-separated or *)
# ─────────────────────────────────────────────
ALLOWED_ORIGINS=*

# ─────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=500

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://narrator:narrator123@localhost:5432/oral_narratives

# SQLite (for lightweight/development mode)
# Set USE_SQLITE=true and comment out DATABASE_URL
USE_SQLITE=false
SQLITE_PATH=./data/oral_narratives.db

# ─────────────────────────────────────────────
# Redis (optional - for async processing)
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────
# Security (CHANGE IN PRODUCTION!)
# ─────────────────────────────────────────────
SECRET_KEY=dev-secret-key-minimum-32-characters-long-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─────────────────────────────────────────────
# Whisper ASR (faster-whisper with CTranslate2)
# ─────────────────────────────────────────────
# Model sizes: tiny (~40MB), base (~150MB), small (~500MB), medium (~1.5GB)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=en
WHISPER_COMPUTE_TYPE=int8

# ─────────────────────────────────────────────
# DeepFace (Facial Analysis)
# ─────────────────────────────────────────────
DEEPFACE_BACKEND=opencv
DEEPFACE_ENFORCE_DETECTION=false

# ─────────────────────────────────────────────
# Feature Flags
# ─────────────────────────────────────────────
ENABLE_FACIAL_ANALYSIS=true
ENABLE_AUDIO_ANALYSIS=true
ENABLE_TRANSCRIPTION=true
ENABLE_MULTIMODAL_FUSION=true
ENABLE_FAISS_INDEXING=true

# ─────────────────────────────────────────────
# Processing Mode
# ─────────────────────────────────────────────
# Set to false for synchronous processing (no Celery required)
ASYNC_PROCESSING=true

# Lightweight mode disables heavy ML features
LIGHTWEIGHT_MODE=false

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ─────────────────────────────────────────────
# GPU (optional)
# ─────────────────────────────────────────────
ENABLE_GPU=false

# ─────────────────────────────────────────────
# Deployment Profiles (docker-compose)
# ─────────────────────────────────────────────
# Full:      docker compose --profile full up -d
# Standard:  docker compose --profile standard up -d
# Lite:      docker compose --profile lite up -d
#
# Lite mode uses SQLite, no Celery/Redis
# Standard mode uses PostgreSQL, Redis, no Celery worker
# Full mode includes everything (PostgreSQL, Redis, Celery, Flower)
